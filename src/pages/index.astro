---
import { Image } from "astro:assets";

import profilePicture from "../assets/identity/ayyman-profile.jpeg";
import puoLogo from "../assets/identity/puo-logo.jpeg";
import SectionHeading from "../components/SectionHeading.astro";
import SiteNav from "../components/SiteNav.astro";
import TechnologyConstellation from "../components/TechnologyConstellation.astro";
import { NAVIGATION, PORTFOLIO } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";

const emailAddress = PORTFOLIO.links.email.replace("mailto:", "");
---

<BaseLayout>
  <SiteNav
    items={NAVIGATION}
    email={PORTFOLIO.links.email}
    name={PORTFOLIO.profile.name}
    initials={PORTFOLIO.profile.initials}
  />

  <main id="main-content" tabindex="-1">
    <section class="hero page-container" id="home" aria-labelledby="hero-heading">
      <div class="hero-edition">
        <span>
          Independent portfolio / <span data-theme-name>Typography</span>
        </span>
        <span>Code. Cloud. Curiosity.</span>
      </div>
      <div class="hero__layout">
        <div class="hero__content glass-card" data-reveal="left">
          <p class="eyebrow">
            {PORTFOLIO.profile.location} · {PORTFOLIO.profile.studyStatus}
          </p>
          <h1 id="hero-heading" aria-label={PORTFOLIO.profile.name}>
            {PORTFOLIO.profile.name.split(" ").map((word) => (
              <span class="name-word" aria-hidden="true">
                {word}
              </span>
            ))}
          </h1>
          <p class="hero__role">{PORTFOLIO.profile.title}</p>
          <p class="hero__tagline">{PORTFOLIO.profile.tagline}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#work">
              View selected work <span aria-hidden="true">↓</span>
            </a>
            <a class="button" href={PORTFOLIO.links.email}>
              Email Ayyman <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <aside class="profile-panel" aria-label="Profile summary" data-reveal="right">
          <button
            class="design-stamp"
            type="button"
            aria-label="Remix the decorative accent"
            title="Give it a spin"
          >
            <svg viewBox="0 0 100 100" aria-hidden="true">
              <path
                d="M50 0 58 29 75 7 72 35 93 25 79 44 100 50 79 58 93 75 70 70 75 93 58 78 50 100 42 78 25 93 30 70 7 75 22 58 0 50 22 42 7 25 30 30 25 7 42 22Z"
                fill="currentColor"
              />
            </svg>
            <span aria-hidden="true">↗</span>
          </button>
          <div class="profile-panel__portrait-frame">
            <Image
              src={profilePicture}
              alt="Ayyman Eussoueff in formal attire"
              class="profile-panel__portrait"
              loading="eager"
              fetchpriority="high"
              format="webp"
              quality={92}
            />
            <span class="profile-panel__monogram" aria-hidden="true">
              {PORTFOLIO.profile.initials}
            </span>
          </div>
          <div class="status-row">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-label">{PORTFOLIO.profile.availability}</span>
          </div>
          <dl class="facts-grid">
            {PORTFOLIO.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
      <div class="hero-bottom">
        <span>Building useful things, with care.</span>
        <a href="#work">
          Explore selected work <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section class="section page-container" id="expertise" aria-labelledby="expertise-heading">
      <SectionHeading
        number="01"
        eyebrow="Expertise"
        heading="Three connected disciplines."
        headingId="expertise-heading"
        description="My direction sits where product development, delivery workflows, and cloud foundations meet."
      />
      <div class="expertise-grid">
        {PORTFOLIO.expertise.map((area, index) => (
          <article class="expertise-card" data-reveal="up" style={`--reveal-delay:${index * 80}ms`}>
            <span class="card-kicker">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.summary}</p>
            <ul class="focus-list" aria-label={`${area.title} focus areas`}>
              {area.focus.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <TechnologyConstellation />

    <section class="section page-container" id="work" aria-labelledby="work-heading">
      <SectionHeading
        number="03"
        eyebrow="Selected work"
        heading="Building in public, one real project at a time."
        headingId="work-heading"
        description="Two source-verified case studies: one collaborative final-year system and one personal Android product prototype."
      />
      <div class="work-layout">
        {PORTFOLIO.featuredProjects.map((project, index) => (
          <article
            class="project-card"
            data-project={project.slug}
            data-reveal={index % 2 === 0 ? "left" : "right"}
            aria-labelledby={`project-${project.slug}`}
          >
            <div class="project-card__top">
              <span class="card-kicker">{project.type}</span>
              <span class="project-status">{project.status}</span>
            </div>
            <div class="project-card__copy">
              <p class="project-card__role">{project.role}</p>
              <h3 id={`project-${project.slug}`}>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <ul class="stack-list" aria-label={`${project.title} technology`}>
              {project.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a
              class="project-link"
              href={project.href}
              aria-label={`Read ${project.title} case study`}
            >
              Read case study <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="section page-container" id="about" aria-labelledby="about-heading">
      <SectionHeading
        number="04"
        eyebrow="About"
        heading="Curious about the whole system."
        headingId="about-heading"
      />
      <div class="about-grid">
        <div class="about-copy glass-card" data-reveal="left">
          {PORTFOLIO.profile.biography.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        <aside class="about-panel" aria-label="Personal approach" data-reveal="right">
          <strong>Build clearly. Ship carefully. Keep learning.</strong>
        </aside>
      </div>
    </section>

    <section class="section page-container" id="journey" aria-labelledby="journey-heading">
      <SectionHeading
        number="05"
        eyebrow="Journey"
        heading="Learning with direction."
        headingId="journey-heading"
        description="Education is shown now; experience, certifications, and achievements will appear only after supporting details are provided."
      />
      <div class="journey-layout">
        {PORTFOLIO.education.map((entry) => (
          <article class="timeline" data-reveal="up">
            <div class="timeline__identity">
              <div class="timeline__crest-frame">
                <Image
                  src={puoLogo}
                  alt="Politeknik Ungku Omar crest"
                  class="timeline__crest"
                  loading="lazy"
                  format="webp"
                  quality={90}
                />
              </div>
              <div class="timeline__copy">
                <div class="timeline__top">
                  <span class="card-kicker">{entry.period}</span>
                  <span>{entry.organization}</span>
                </div>
                <h3>{entry.title}</h3>
                <p>{entry.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section page-container" id="now" aria-labelledby="now-heading">
      <SectionHeading
        number="06"
        eyebrow="Now"
        heading="What I am focused on now."
        headingId="now-heading"
        description="A current snapshot of study, opportunity, practice, and the habits I want to strengthen."
      />
      <div class="now-grid">
        {PORTFOLIO.now.map((item, index) => (
          <article class="now-card" data-reveal="up" style={`--reveal-delay:${index * 65}ms`}>
            <span class="card-kicker">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section page-container" id="contact" aria-labelledby="contact-heading">
      <SectionHeading
        number="07"
        eyebrow="Contact"
        heading="Let’s build something useful."
        headingId="contact-heading"
        description="I’m open to conversations about full-time roles, internships, collaboration, and thoughtful software projects."
      />
      <div class="contact-grid">
        <div class="contact-panel" data-reveal="left">
          <span class="card-kicker">Start a conversation</span>
          <a class="contact-email" href={PORTFOLIO.links.email}>
            {emailAddress}
          </a>
          <p class="contact-copy">
            The secure on-site form arrives after the local design is approved. Email works now.
          </p>
        </div>
        <div class="contact-panel" data-reveal="right">
          <span class="card-kicker">Elsewhere</span>
          <div class="social-links">
            <a class="social-link" href={PORTFOLIO.links.github} target="_blank" rel="noreferrer">
              GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="social-link" href={PORTFOLIO.links.linkedin} target="_blank" rel="noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
          {PORTFOLIO.resumeUrl && (
            <a class="button" href={PORTFOLIO.resumeUrl}>
              Download résumé
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="page-container footer-row glass-card" data-reveal="up">
      <p>
        © {new Date().getFullYear()} {PORTFOLIO.profile.name}
      </p>
      <p class="footer-meta">Designed and engineered as a side project.</p>
    </div>
  </footer>
</BaseLayout>
