---
import { Image } from "astro:assets";
import profilePicture from "../assets/identity/ayyman-profile.jpeg";
import puoLogo from "../assets/identity/puo-logo.jpeg";
import SectionHeading from "../components/SectionHeading.astro";
import SiteNav from "../components/SiteNav.astro";
import TechnologyConstellation from "../components/TechnologyConstellation.astro";
import { NAVIGATION, PORTFOLIO } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/home.css";
const emailAddress = PORTFOLIO.links.email.replace("mailto:", "");
---

<BaseLayout>
  <SiteNav
    items={NAVIGATION}
    email={PORTFOLIO.links.email}
    name={PORTFOLIO.profile.name}
    initials={PORTFOLIO.profile.initials}
  />
  <main id="main-content" tabindex="-1">
    <section class="hero page-container" id="home" aria-labelledby="hero-heading">
      <div class="hero-edition">
        <span>Software engineering / Personal portfolio</span>
        <span>Kuala Lumpur, MY</span>
      </div>
      <div class="hero__layout">
        <div class="hero__content" data-reveal="up">
          <p class="eyebrow">Full-stack development. Cloud foundations.</p>
          <h1 id="hero-heading" aria-label={PORTFOLIO.profile.name}>
            {PORTFOLIO.profile.name.split(" ").map((word) => (
              <span class="name-word" aria-hidden="true">
                {word}
              </span>
            ))}
          </h1>
          <p class="hero__role">{PORTFOLIO.profile.title}</p>
          <p class="hero__tagline">{PORTFOLIO.profile.tagline}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#work">
              Explore the work <span aria-hidden="true">↘</span>
            </a>
            <a class="button" href={PORTFOLIO.resumeUrl}>
              View résumé / CV <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <aside class="profile-panel" aria-label="Profile summary" data-reveal="up">
          <figure class="profile-panel__portrait-frame">
            <Image
              src={profilePicture}
              alt="Ayyman Eussoueff in formal attire"
              class="profile-panel__portrait"
              loading="eager"
              fetchpriority="high"
              format="webp"
              quality={92}
            />
            <figcaption class="portrait-caption">
              <span>Ayyman Eussoueff</span>
              <span>01 / Portrait</span>
            </figcaption>
          </figure>
          <div class="status-row">
            <span class="status-dot" aria-hidden="true"></span>
            <span>{PORTFOLIO.profile.availability}</span>
          </div>
          <dl class="facts-grid">
            {PORTFOLIO.facts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
      <div class="hero-bottom">
        <span>Build clearly. Ship carefully. Keep learning.</span>
        <a href="#work">
          Selected work <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <section class="section page-container" id="work" aria-labelledby="work-heading">
      <SectionHeading
        number="01"
        eyebrow="Selected work"
        heading="From interface to infrastructure."
        headingId="work-heading"
        description="Two projects, two different scales. A connected contractor workflow and a local-first Android experience."
      />
      <div class="work-layout">
        {PORTFOLIO.featuredProjects.map((project, index) => (
          <article
            class="project-card"
            data-project={project.slug}
            data-reveal="up"
            aria-labelledby={`project-${project.slug}`}
          >
            <div class="project-card__top">
              <span class="project-index" aria-hidden="true">
                0{index + 1}
              </span>
              <span class="card-kicker">{project.type}</span>
              <span class="project-status">{project.status}</span>
            </div>
            <div class="project-card__copy">
              <p class="project-card__role">{project.role}</p>
              <h3 id={`project-${project.slug}`}>{project.title}</h3>
              <p>{project.summary}</p>
            </div>
            <div class="project-details">
              <ul class="stack-list" aria-label={`${project.title} technology`}>
                {project.stack.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a
                class="project-link"
                href={project.href}
                aria-label={`Read ${project.title} case study`}
              >
                Read case study <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
      <p class="work-note">
        Case studies cover context, contribution, architecture, and the limits of each prototype.
      </p>
    </section>

    <section class="section page-container" id="expertise" aria-labelledby="expertise-heading">
      <SectionHeading
        number="02"
        eyebrow="Engineering focus"
        heading="The whole system matters."
        headingId="expertise-heading"
        description="My direction connects the software people use with the systems that help it run reliably."
      />
      <div class="expertise-grid">
        {PORTFOLIO.expertise.map((area) => (
          <article class="expertise-card" data-reveal="up">
            <span class="card-kicker">{area.number}</span>
            <h3>{area.title}</h3>
            <p>{area.summary}</p>
            <ul class="focus-list" aria-label={`${area.title} focus areas`}>
              {area.focus.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <TechnologyConstellation />

    <section class="section page-container" id="about" aria-labelledby="about-heading">
      <SectionHeading
        number="04"
        eyebrow="A little background"
        heading="Curious about the whole system."
        headingId="about-heading"
      />
      <div class="about-grid">
        <aside class="about-aside">
          {PORTFOLIO.profile.location}
          <br />
          {PORTFOLIO.profile.studyStatus}
        </aside>
        <div class="about-copy" data-reveal="up">
          {PORTFOLIO.profile.biography.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <p class="about-motto">
            Build clearly. Ship carefully.
            <br />
            Keep learning.
          </p>
        </div>
      </div>
    </section>

    <section class="section page-container" id="journey" aria-labelledby="journey-heading">
      <SectionHeading
        number="05"
        eyebrow="Education & recognition"
        heading="Learning with direction."
        headingId="journey-heading"
      />
      <div class="journey-layout">
        {PORTFOLIO.education.map((entry) => (
          <article class="timeline" data-reveal="up">
            <div class="timeline__identity">
              <div class="timeline__crest-frame">
                <Image
                  src={puoLogo}
                  alt="Politeknik Ungku Omar crest"
                  class="timeline__crest"
                  loading="lazy"
                  format="webp"
                  quality={90}
                />
              </div>
              <div class="timeline__copy">
                <div class="timeline__top">
                  <span class="card-kicker">{entry.period}</span>
                  <span>{entry.organization}</span>
                </div>
                <h3>{entry.title}</h3>
                <p>{entry.description}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
      <div class="credentials">
        <section class="credential" id="awards" aria-labelledby="awards-heading">
          <span class="card-kicker">Recognition</span>
          <h3 id="awards-heading">Awards</h3>
          {PORTFOLIO.achievements.length > 0 ? (
            PORTFOLIO.achievements.map((entry) => (
              <article>
                <h4>{entry.title}</h4>
                <p>
                  {entry.organization} · {entry.period}
                </p>
                <p>{entry.description}</p>
              </article>
            ))
          ) : (
            <p>Award details have not been published yet.</p>
          )}
        </section>
        <section class="credential" id="resume" aria-labelledby="resume-heading">
          <span class="card-kicker">Background & experience</span>
          <h3 id="resume-heading">Résumé</h3>
          <p>Education, projects, awards, and experience. Read online or take a PDF copy.</p>
          <a class="text-link" href={PORTFOLIO.resumeUrl}>
            View résumé / CV <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href={PORTFOLIO.resumePdfUrl} download>
            Download PDF <span aria-hidden="true">↓</span>
          </a>
        </section>
      </div>
    </section>

    <section class="section page-container" id="now" aria-labelledby="now-heading">
      <SectionHeading
        number="06"
        eyebrow="Currently"
        heading="What I am focused on now."
        headingId="now-heading"
      />
      <div class="now-grid">
        {PORTFOLIO.now.map((item) => (
          <article class="now-card" data-reveal="up">
            <span class="card-kicker">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section
      class="section page-container contact-section"
      id="contact"
      aria-labelledby="contact-heading"
    >
      <SectionHeading
        number="07"
        eyebrow="Get in touch"
        heading="Let’s build something useful."
        headingId="contact-heading"
      />
      <div class="contact-grid">
        <p class="contact-intro">
          Open to full-time roles,
          <br />
          internships & collaboration.
        </p>
        <div data-reveal="up">
          <a class="contact-email" href={PORTFOLIO.links.email} aria-label="Email Ayyman">
            {emailAddress} <span aria-hidden="true">↗</span>
          </a>
          <p class="contact-copy">
            Have a role, a project, or a good engineering problem? Let’s talk.
          </p>
          <div class="social-links">
            <a class="social-link" href={PORTFOLIO.links.github} target="_blank" rel="noreferrer">
              GitHub <span aria-hidden="true">↗</span>
            </a>
            <a class="social-link" href={PORTFOLIO.links.linkedin} target="_blank" rel="noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer">
    <div class="page-container footer-row">
      <p>
        © {new Date().getFullYear()} {PORTFOLIO.profile.name}
      </p>
      <p class="footer-meta">Software, systems & a little curiosity.</p>
      <a href="#home">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>
