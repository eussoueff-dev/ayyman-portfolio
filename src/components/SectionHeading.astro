---
interface Props {
  number: string;
  eyebrow: string;
  heading: string;
  headingId: string;
  description?: string;
}

const { number, eyebrow, heading, headingId, description } = Astro.props;
---

<header class="section-heading" data-reveal>
  <div class="section-heading__meta">
    <span>{number}</span>
    <span>{eyebrow}</span>
  </div>
  <div class="section-heading__copy">
    <h2 id={headingId}>{heading}</h2>
    {description && <p>{description}</p>}
  </div>
</header>
