---
import "../styles/theme-backdrops.css";
---

<div class="theme-backdrop" aria-hidden="true" inert>
  <div class="backdrop-scene backdrop-scene--typography" data-backdrop="typography">
    <div class="type-rules"></div>
    <span class="type-specimen backdrop-motion">Aa</span>
    <span class="type-ampersand backdrop-motion">&amp;</span>
    <div class="type-baseline backdrop-motion"></div>
  </div>

  <div class="backdrop-scene backdrop-scene--minimalism" data-backdrop="minimalism">
    <div class="minimal-wash backdrop-motion"></div>
    <svg class="minimal-water" viewBox="0 0 1000 1000" fill="none">
      <defs>
        <filter id="water-refraction" x="-20%" y="-20%" width="140%" height="140%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.009"
            numOctaves="2"
            seed="8"
            result="water"
          />
          <feDisplacementMap
            in="SourceGraphic"
            in2="water"
            scale="65"
            xChannelSelector="R"
            yChannelSelector="G"
          />
        </filter>
        <pattern id="water-cells" width="240" height="240" patternUnits="userSpaceOnUse">
          <path d="M-30 60Q60-40 120 60T270 60M-30 180Q60 80 120 180T270 180M60-30Q-40 60 60 120T60 270M180-30Q80 60 180 120T180 270" />
        </pattern>
      </defs>
      <g filter="url(#water-refraction)">
        <rect
          class="water-current backdrop-motion"
          x="-100"
          y="-100"
          width="1200"
          height="1200"
          fill="url(#water-cells)"
        />
        <rect
          class="water-current water-current--echo backdrop-motion"
          x="-100"
          y="-100"
          width="1200"
          height="1200"
          fill="url(#water-cells)"
        />
      </g>
    </svg>
    <div class="minimal-lens"></div>
  </div>

  <div class="backdrop-scene backdrop-scene--brutalism" data-backdrop="brutalism">
    <div class="draft-grid"></div>
    <svg class="draft-glyphs" width="100%" height="100%">
      <defs>
        <pattern id="draft-glyphs" width="168" height="168" patternUnits="userSpaceOnUse">
          <g font-family="monospace" font-size="17" text-anchor="middle">
            {[
              "+ · / : × .",
              ": ▪ + . / :",
              "× : . + ▪ /",
              ". / × : . +",
              "+ . : ▪ / ×",
              "/ × + . : ▪",
            ].map((row, y) => (
              <text y={y * 28 + 20}>
                {row.split(" ").map((glyph, x) => (
                  <tspan x={x * 28 + 14}>{glyph}</tspan>
                ))}
              </text>
            ))}
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#draft-glyphs)" opacity="0.09" />
      <g class="glyph-reveal">
        <rect width="100%" height="100%" fill="#d8fa36" opacity="0.65" />
        <rect
          class="glyph-current backdrop-motion"
          x="-28"
          y="-28"
          width="110%"
          height="110%"
          fill="url(#draft-glyphs)"
        />
      </g>
    </svg>
    <div class="draft-scan backdrop-motion"></div>
    <div class="draft-hatch backdrop-motion"></div>
    <span class="draft-cross draft-cross--one">+</span>
    <span class="draft-cross draft-cross--two">+</span>
  </div>

  <div class="backdrop-scene backdrop-scene--maximalism" data-backdrop="maximalism">
    <div class="collage-checks backdrop-motion"></div>
    <div class="collage-ring backdrop-motion"></div>
    <svg class="collage-flower backdrop-motion" viewBox="0 0 200 200">
      {[0, 60, 120].map((angle) => (
        <ellipse cx="100" cy="100" rx="30" ry="96" transform={`rotate(${angle} 100 100)`} />
      ))}
      <circle cx="100" cy="100" r="23" />
    </svg>
    <svg class="collage-wave backdrop-motion" viewBox="0 0 500 150" fill="none">
      <path d="M-20 100Q30-20 80 100T180 100T280 100T380 100T480 100T580 100" />
      <path d="M-20 125Q30 5 80 125T180 125T280 125T380 125T480 125T580 125" />
    </svg>
    <div class="collage-confetti backdrop-motion"></div>
  </div>
</div>
