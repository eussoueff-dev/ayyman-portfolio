  siC,
  siDocker,
  siFirebase,
  siJavascript,
  siKubernetes,
  siNextdotjs,
  siNvidia,
  siOllama,
  siPython,
  siSupabase,
  siTypescript,
  siVercel,
} from "simple-icons";

import BrandOrbCluster from "./react/BrandOrbCluster";
import SectionHeading from "./SectionHeading.astro";
import "../styles/technology-constellation.css";

interface TechnologyNode {
  label: string;
  slug: string;
  color: `#${string}`;
  x: number;
  y: number;
  duration: number;
  delay: number;
  icon?: {
    path: string;
  };
  mark?: string;
}

