const accessibleTechnologyNames = [
  "ChatGPT",
  "Claude",
  "Gemini",
  "GitHub",
  "React",
  ...technologies.map((technology) => technology.label),
];
---

<section
  class="section page-container technology-section"
  id="stack"
  aria-labelledby="stack-heading"
>
  <SectionHeading
    number="02"
    eyebrow="Technology orbit"
    heading="The tools in my working universe."
    headingId="stack-heading"
    description="A living map of the languages, platforms, AI tools, and cloud services I have used while learning and building."
  />

  <div class="technology-scene glass-card" data-reveal="scale">
    <div class="technology-core">
      <p class="technology-core__eyebrow">Tool constellation</p>
      <h3>Twenty tools. One connected workflow.</h3>
      <p>
        From product code to deployment and AI-assisted exploration, each tool represents part of
        how I turn an idea into a working system.
      </p>
      <span class="technology-core__signal">Live stack</span>
    </div>

    <span class="orbit-ring orbit-ring--one" aria-hidden="true"></span>
    <span class="orbit-ring orbit-ring--two" aria-hidden="true"></span>
    <span class="orbit-ring orbit-ring--three" aria-hidden="true"></span>

    <BrandOrbCluster client:visible />

    <ul class="technology-nodes" aria-hidden="true">
      {technologies.map((technology) => (
        <li
          class="tech-node"
          data-tech={technology.slug}
          style={`--brand:${technology.color};--node-x:${technology.x}%;--node-y:${technology.y}%;--node-duration:${technology.duration}s;--node-delay:${technology.delay}s`}
        >
          {technology.icon ? (
            <svg class="tech-node__icon" viewBox="0 0 24 24" role="presentation">
              <path fill="currentColor" d={technology.icon.path}></path>
            </svg>
          ) : (
            <span class={`tech-node__monogram tech-node__monogram--${technology.slug}`}>
              {technology.slug === "kiro" ? <span>{technology.mark}</span> : technology.mark}
            </span>
          )}
          <span class="tech-node__label">{technology.label}</span>
        </li>
      ))}
    </ul>

    <ul class="sr-only" aria-label="Technologies Ayyman has used">
      {accessibleTechnologyNames.map((technology) => (
        <li>{technology}</li>
      ))}
    </ul>
  </div>
</section>
