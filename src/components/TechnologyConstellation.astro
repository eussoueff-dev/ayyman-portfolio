---
import SectionHeading from "./SectionHeading.astro";
import "../styles/technology-constellation.css";

const groups = [
  {
    label: "Languages & interfaces",
    tools: ["JavaScript", "TypeScript", "React", "Next.js", "Python", "C"],
  },
  {
    label: "Cloud & delivery",
    tools: ["Firebase", "AWS", "Supabase", "Vercel", "Docker", "Kubernetes", "GitHub"],
  },
  {
    label: "AI-assisted exploration",
    tools: ["ChatGPT", "Claude", "Gemini", "Ollama", "NVIDIA", "Kiro", "Hermes AI"],
  },
];
---

<section
  class="section page-container technology-section"
  id="stack"
  aria-labelledby="stack-heading"
>
  <SectionHeading
    number="03"
    eyebrow="Working toolkit"
    heading="Tools serve the work."
    headingId="stack-heading"
    description="Languages, platforms, and tools I have used while learning and building. Project-specific technologies are listed in each case study."
  />
  <dl class="toolkit" aria-label="Technologies Ayyman has used">
    {groups.map((group) => (
      <div class="toolkit-row" data-reveal="up">
        <dt>{group.label}</dt>
        <dd>
          {group.tools.map((tool) => (
            <span>{tool}</span>
          ))}
        </dd>
      </div>
    ))}
  </dl>
</section>
